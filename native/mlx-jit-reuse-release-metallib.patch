diff --git a/mlx/backend/metal/kernels/CMakeLists.txt b/mlx/backend/metal/kernels/CMakeLists.txt
index 07624e18..5f656e6c 100644
--- a/mlx/backend/metal/kernels/CMakeLists.txt
+++ b/mlx/backend/metal/kernels/CMakeLists.txt
@@ -1,3 +1,23 @@
+# Local benchmark support: with JIT enabled, base kernel definitions remain
+# identical to the release wheel while modified matrix kernels compile at run time.
+if(MLX_PREBUILT_METALLIB)
+  add_custom_command(
+    OUTPUT ${MLX_METAL_PATH}/mlx.metallib
+    COMMAND ${CMAKE_COMMAND} -E make_directory ${MLX_METAL_PATH}
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            ${MLX_PREBUILT_METALLIB} ${MLX_METAL_PATH}/mlx.metallib
+    DEPENDS ${MLX_PREBUILT_METALLIB}
+    COMMENT "Reusing matching-release base Metal kernels"
+    VERBATIM)
+  add_custom_target(mlx-metallib DEPENDS ${MLX_METAL_PATH}/mlx.metallib)
+  add_dependencies(mlx mlx-metallib)
+  include(GNUInstallDirs)
+  install(FILES ${MLX_METAL_PATH}/mlx.metallib
+          DESTINATION ${CMAKE_INSTALL_LIBDIR}
+          COMPONENT metallib)
+  return()
+endif()
+
 set(BASE_HEADERS
     bf16.h
     bf16_math.h
diff --git a/mlx/backend/metal/make_compiled_preamble_offline.py b/mlx/backend/metal/make_compiled_preamble_offline.py
new file mode 100644
index 00000000..886ea855
--- /dev/null
+++ b/mlx/backend/metal/make_compiled_preamble_offline.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Embed local Metal headers without an offline Metal compiler.
+
+Used only by the matching-release-metallib JIT experiment. Local literal quoted
+includes are expanded in place. Metal/system includes, macros and conditionals
+are left for the actual runtime Metal compiler. Explicit guards implement each
+header's pragma-once semantics across concatenated source fragments.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import sys
+from pathlib import Path
+
+QUOTED_INCLUDE = re.compile(r'^\s*#\s*include\s+"([^"\n]+)"\s*(?://.*)?$')
+PRAGMA_ONCE = re.compile(r'^\s*#\s*pragma\s+once\s*(?://.*)?$')
+
+
+def expand_header(path: Path, root: Path, ancestors: tuple[Path, ...] = ()) -> str:
+    path = path.resolve(strict=True)
+    relative = path.relative_to(root).as_posix()
+    lines = path.read_text().splitlines(keepends=True)
+    once = any(PRAGMA_ONCE.match(line) for line in lines)
+    if path in ancestors:
+        # No such cycles occur in this source tree; fail rather than invent
+        # preprocessor behavior for an unexpected future header graph.
+        raise ValueError(f'Include cycle involving {relative}')
+    guard = 'MLX_OFFLINE_JIT_ONCE_' + hashlib.sha256(relative.encode()).hexdigest()[:24].upper()
+    out = []
+    if once:
+        out += [f'#ifndef {guard}\n', f'#define {guard}\n']
+    out.append(f'#line 1 "{relative}"\n')
+    for number, line in enumerate(lines, 1):
+        if PRAGMA_ONCE.match(line):
+            out.append('\n')
+            continue
+        include = QUOTED_INCLUDE.match(line)
+        if include:
+            name = include.group(1)
+            candidates = [path.parent / name, root / name]
+            dependency = next((p for p in candidates if p.is_file()), None)
+            if dependency is None:
+                raise FileNotFoundError(f'{relative}:{number}: cannot resolve {name}')
+            out.append(expand_header(dependency, root, ancestors + (path,)))
+            out.append(f'\n#line {number + 1} "{relative}"\n')
+        else:
+            if re.match(r'^\s*#\s*include\s+[^<"]', line):
+                raise ValueError(f'{relative}:{number}: unsupported non-literal include')
+            out.append(line)
+    if not out[-1].endswith('\n'):
+        out.append('\n')
+    if once:
+        out.append(f'#endif // {guard}\n')
+    return ''.join(out)
+
+
+def main() -> None:
+    output_dir, source_root, source_name = sys.argv[1:]
+    root = Path(source_root).resolve(strict=True)
+    source = root / 'mlx/backend/metal/kernels' / (source_name + '.h')
+    expanded = expand_header(source, root)
+    delimiter = 'mlx_offline_jit'
+    if f'){delimiter}"' in expanded:
+        raise ValueError('Raw-string delimiter appears in source')
+    function = Path(source_name).name
+    output = Path(output_dir) / (function + '.cpp')
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(
+        '// Generated by make_compiled_preamble_offline.py; source is unchanged.\n'
+        'namespace mlx::core::metal {\n'
+        f'const char* {function}() {{\n'
+        f'  return R"{delimiter}(\n{expanded}){delimiter}";\n'
+        '}\n} // namespace mlx::core::metal\n'
+    )
+
+
+if __name__ == '__main__':
+    main()
